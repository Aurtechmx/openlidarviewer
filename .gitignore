# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules
.pnp
.pnp.*

# ── Build output ─────────────────────────────────────────────────────────────
# NOTE: these are anchored to the repo root (leading `/`). An unanchored `build`
# matched `src/build/` anywhere and silently un-tracked `src/build/buildIdentity.ts`,
# which broke a clean checkout's typecheck/build. Keep these root-anchored.
/dist
/dist-ssr
/build
/vbuild
/distcheck
/coverage
*.tsbuildinfo

# ── Test / tooling output ────────────────────────────────────────────────────
test-results
playwright-report
playwright/.cache
# Vite / Vitest transient config transpiles (e.g. vitest.config.ts.timestamp-*.mjs)
*.timestamp-*.mjs

# ── Secrets & local environment — never publish these ───────────────────────
.env
.env.*
!.env.example
.npmrc
*.pem
*.key
*.p12
*.keystore
secrets.*
*.local

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── Generated archives & packaged deliverables ───────────────────────────────
# Keeps local deploy / package artifacts from drifting into a GitHub upload.
*.zip
*.tar
*.tar.gz
*.tgz
*.bundle

# ── Generated release artifacts (npm run package output) ─────────────────────
# The whole release/ tree (checksums, manifest, deploy/source zips, prior
# RELEASE_DESCRIPTION_*.md) is regenerated by `npm run package`. Ignoring it
# stops packaged output from being committed and shipped as stale artifacts
# inside the git-archive source zip. Also excluded from git archive via
# `.gitattributes` (release/ export-ignore).
#
# Anchored to the ROOT. Unanchored, `release/` matches a directory of that name
# at any depth, which silently swallowed docs/release/ — documentation that is
# meant to ship.
/release/

# ── Local scratch & verification scripts (not for publishing) ────────────────
# Anchored for the same reason as /release/: unanchored, `verify-*.mjs` matched
# scripts/verify-release-assets.mjs, so the script `npm run release:verify`
# invokes was never committed and the command was broken for anyone who cloned.
_*.mjs
/verify-*.mjs
trycheck*.mjs
*.tmp
_rmtest*

# ── Editor / OS ──────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
bundle-stats.html

# sandbox / editor artifacts — never commit
.fuse_hidden*
pw.sandbox.config.mjs

# local-only scratch
scratch/

# ── Private R&D artifacts — keep public/private separation airtight ──────────
# By convention these live OUTSIDE this published repo (in the parent project
# folder). Ignoring the naming patterns is defence-in-depth: even a stray copy
# dropped inside the repo can never be accidentally committed or shipped in the
# git-archive source zip. (Public RELEASE_NOTES_*.md are intentionally NOT here.)
_PRIVATE/
RESEARCH DOCUMENTS/
*WORKPLAN*.md
*WHITEPAPER*.md
*AUDIT*.md
TECH_EVALUATION*.md
QUALITYREVISION*.md
GITHUB_RELEASE_*.md
ELITE_*.md
# Large / classified sample clouds are private test data, not shipped fixtures
# (the tracked tiny.las / tiny.laz fixtures are bytes, not *.copc.laz).
*.copc.laz
*.copc.laz.*

# Local tooling / editor metadata (ignored via .git/info/exclude, not shipped)

# Generated reproducibility artifacts (regenerate with npm run repro)
benchmarks/out/

# Benchmark suite output (regenerate with npm run benchmark:quick). The archive
# subtree grows one immutable directory per run, so it is kept out of the repo;
# a result set that needs publishing is attached to a release, not committed.
/benchmark-results/

# ── Docs-site build output (regenerate with npm run docs:build) ──────────────
# The rendered claim-register partial (docs-site/validation/
# claim-register.generated.md) IS committed — same convention as
# src/validation/claimRegistry.generated.ts.
docs-site/.vitepress/dist/
docs-site/.vitepress/cache/

# Local Python virtualenv (docs/validation tooling) — never commit
.venv/
coverage/
reports/
.stryker-tmp/

# Local authoring tools, not part of the project.
_private/

# Reachability run output. The claim registry (validation/reachability/
# claims.json) is committed; the witnesses a run leaves behind are not — a
# checkout with no run of its own should read as not-executed, not as green.
/validation/reachability/ledger/
/validation/reachability/summary.json

# Agent-plugin scaffolding written into the working tree by tooling.
# It is not part of the software and its internal links do not resolve
# inside a source archive, which fails archive portability verification.
.agents/
skills-lock.json

# Editor and agent working directories — local scratch, not part of the
# software. Ignored here (rather than only in .git/info/exclude) so the
# exclusion travels with the repository and survives a fresh clone.
.claude/
.vscode/
.idea/

# Python bytecode — a compiled artifact nobody reads, and one that would pin an
# interpreter version into a tree that states 3.11 in .python-version.
__pycache__/
*.py[cod]

# Brainstorming companion mockups — local only.
.superpowers/

# Coconino validation tile cache (multi-GB USGS LAZ, fetched on demand)
_coconino_tiles/
coconino-next-*-tiles.csv
