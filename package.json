{
  "name": "openlidarviewer",
  "version": "0.6.7",
  "description": "View supported LiDAR and point-cloud datasets locally in a browser. No installation or account required; local files are not uploaded.",
  "license": "AGPL-3.0-only",
  "author": "A. Urias",
  "homepage": "https://lidar.aurtech.mx/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aurtechmx/openlidarviewer.git"
  },
  "bugs": {
    "url": "https://github.com/Aurtechmx/openlidarviewer/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.2",
  "keywords": [
    "lidar",
    "point-cloud",
    "las",
    "laz",
    "e57",
    "ply",
    "gltf",
    "viewer",
    "three.js",
    "webgpu"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:live": "bash -c 'set -o pipefail; s=$(date +%s); tsc --noEmit && vite build --mode live; c=$?; e=$(( $(date +%s) - s )); echo \"[build:live] elapsed=${e}s exit=${c}\"; if [ $c -eq 0 ] && [ $e -gt 120 ]; then echo \"[build:live] WARNING: took ${e}s. A healthy live build is well under a minute; \" \"the obfuscator transform is the usual cause. Re-run and compare before trusting a timing-sensitive result.\" >&2; fi; exit $c'",
    "package": "bash scripts/package.sh",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:deps": "node scripts/check-dep-singletons.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "node scripts/test-bucket.mjs unit --shards=3",
    "test:export": "node scripts/test-bucket.mjs export",
    "test:terrain": "node scripts/test-bucket.mjs terrain --shards=2",
    "test:ui": "node scripts/test-bucket.mjs ui",
    "test:slow": "node scripts/test-bucket.mjs slow --shards=2",
    "test:buckets:verify": "node scripts/test-bucket.mjs --verify",
    "test:file": "node scripts/test-file.mjs",
    "test:build": "npm run build && BUILD_CONTRACT=1 vitest run tests/chunkIsolation.test.ts tests/orbitSmoke.test.ts",
    "test:e2e": "playwright test --project=deterministic",
    "e2e:browsers": "playwright install chromium firefox webkit",
    "repro:metrics": "REPRO=1 vitest run tests/reproPack.test.ts",
    "repro:figures": "python3 benchmarks/plots.py",
    "repro": "npm run repro:metrics && npm run repro:figures",
    "benchmark:repro": "BENCHMARK_SUITES=reproducibility vitest run tests/benchmark/runSuites.test.ts --testTimeout=3600000",
    "benchmark:scaling": "BENCHMARK_SUITES=scaling vitest run tests/benchmark/runSuites.test.ts --testTimeout=3600000",
    "benchmark:quick": "BENCHMARK_SUITES=reproducibility,scaling vitest run tests/benchmark/runSuites.test.ts --testTimeout=3600000 && npm run benchmark:verify",
    "benchmark:loaders": "BENCHMARK_SUITES=loaderComparison vitest run tests/benchmark/runSuites.test.ts --testTimeout=3600000 && npm run benchmark:verify",
    "benchmark:scaling:gc": "BENCHMARK_FORCE_GC=1 npm run benchmark:scaling",
    "benchmark:quick:gc": "BENCHMARK_FORCE_GC=1 npm run benchmark:quick",
    "benchmark:units": "vitest run tests/benchmark/unitIntegrity.test.ts",
    "benchmark:repro:portable": "BENCHMARK_PORTABLE=1 vitest run tests/benchmark/runPortable.test.ts --testTimeout=3600000",
    "benchmark:compare-platforms": "BENCHMARK_COMPARE=1 vitest run tests/benchmark/comparePlatforms.test.ts --testTimeout=600000",
    "benchmark:roundtrip": "vitest run tests/benchmark/roundtripFidelity.test.ts --reporter=verbose",
    "benchmark:contours": "vitest run tests/benchmark/contourCorrectness.test.ts --testTimeout=600000",
    "benchmark:provenance": "vitest run tests/benchmark/provenanceIntegrity.test.ts --testTimeout=600000",
    "benchmark:failures": "BENCHMARK_FAILURES=1 vitest run tests/benchmark/failureRecovery.test.ts --testTimeout=600000",
    "benchmark:backends": "BENCHMARK_BACKENDS=1 vitest run tests/benchmark/runBackends.test.ts --testTimeout=600000",
    "benchmark:backends:gpu": "playwright test tests/e2e/backendGpuLeg.spec.ts --project=gpu --headed",
    "benchmark:archive-portability": "node scripts/verify-archive-portability.mjs",
    "benchmark:seeds": "vitest run tests/benchmark/seedSensitivity.test.ts --testTimeout=1800000",
    "benchmark:frame:compare": "vitest run tests/benchmark/frameRecord.test.ts",
    "benchmark:streaming-nav": "STREAMING_NAV_WRITE=1 vitest run tests/benchmark/streamingNav.test.ts --testTimeout=600000",
    "benchmark:profile-section": "PROFILE_SECTION_WRITE=1 vitest run tests/benchmark/profileSection.test.ts --testTimeout=3600000 --reporter=verbose",
    "benchmark:profile-section:gc": "BENCHMARK_FORCE_GC=1 npm run benchmark:profile-section",
    "benchmark:clean-clone": "node scripts/verify-clean-clone.mjs",
    "benchmark:clean-clone:install": "node scripts/verify-clean-clone.mjs --install",
    "benchmark:publication:quick": "node scripts/publication-battery.mjs quick",
    "benchmark:publication:verify": "node scripts/publication-battery.mjs verify",
    "benchmark:verify": "BENCHMARK_VERIFY=1 vitest run tests/benchmark/verifyResults.test.ts --testTimeout=600000",
    "benchmark:verify:archives": "BENCHMARK_VERIFY_ARCHIVES=1 vitest run tests/benchmark/verifyResults.test.ts --testTimeout=1800000",
    "test:smoke": "playwright test --project=deterministic tests/e2e/smoke.spec.ts tests/e2e/lazyChunkLoad.spec.ts",
    "test:smoke:live": "SMOKE_LIVE=1 playwright test --project=deterministic tests/e2e/smoke.spec.ts tests/e2e/lazyChunkLoad.spec.ts",
    "test:smoke:mobile": "playwright test --project=deterministic tests/e2e/visualsStudioMobile.spec.ts",
    "test:smoke:widths": "playwright test --config=playwright.widths.config.ts tests/e2e/smoke.spec.ts",
    "test:release": "npm run test:release:execute && npm run lint:evidence",
    "lint:main-deferral": "node scripts/lint-main-deferral.mjs",
    "lint:inline-imports": "node scripts/lint-inline-imports.mjs",
    "lint:unsafe-html": "node scripts/lint-unsafe-html.mjs",
    "lint:layer-boundaries": "node scripts/lint-layer-boundaries.mjs",
    "lint:mono-usage": "node scripts/lint-mono-usage.mjs",
    "lint:editorial-language": "node scripts/lint-editorial-language.mjs",
    "lint:no-ignored-src": "node scripts/lint-no-ignored-src.mjs",
    "lint:no-tracked-ignored": "node scripts/lint-no-tracked-ignored.mjs",
    "lint:claim-register": "node scripts/lint-claim-register.mjs",
    "gen:claim-registry": "node scripts/generate-claim-registry.mjs",
    "lint:release-sync": "node scripts/lint-release-sync.mjs",
    "lint:release-truth": "node scripts/lint-release-truth.mjs",
    "gen:provenance": "node scripts/sync-provenance.mjs",
    "lint:sbom": "node scripts/lint-sbom.mjs",
    "release:verify": "node scripts/verify-release-assets.mjs",
    "release:manifest": "node scripts/create-release-manifest.mjs",
    "docs:render": "node scripts/render-claim-register.mjs",
    "docs:dev": "npm run docs:render && vitepress dev docs-site",
    "docs:build": "npm run docs:render && vitepress build docs-site && node scripts/lint-docs-site.mjs",
    "docs:preview": "vitepress preview docs-site",
    "test:e2e:gpu": "playwright test --project=gpu",
    "coverage": "OLV_REACHABILITY=0 vitest run --coverage --maxWorkers=2 --testTimeout=60000 --exclude='tests/terrainRunnerDensityWiring.test.ts' --exclude='tests/benchmark/terrainCoreRebuildCost.test.ts'",
    "mutation": "stryker run",
    "evidence": "bash -c 'set -o pipefail; mkdir -p release; npm run test:release:execute > release/gate.log 2>&1; code=$?; node scripts/collect-evidence.mjs release/gate.log \"$code\" && npm run lint:evidence'",
    "lint:evidence": "node scripts/lint-evidence.mjs",
    "lint:upload-queue-seam": "node scripts/lint-upload-queue-seam.mjs",
    "validation:snapshot": "node scripts/build-validation-snapshot.mjs",
    "validation:snapshot:verify": "node scripts/verify-validation-snapshot.mjs --controls",
    "verify:reachability": "node scripts/verify-reachability.mjs",
    "validation:defects:replay": "node scripts/replay-defects.mjs",
    "validation:defects:replay:verify": "node scripts/verify-defect-replay.mjs",
    "validation:field:verify": "node scripts/verify-field-study.mjs",
    "validation:reproduction:verify": "node scripts/verify-reproduction-record.mjs",
    "validation:generalization:verify": "node scripts/verify-generalization-record.mjs",
    "validation:impact:verify": "node scripts/verify-impact-record.mjs",
    "validation:impact:summary": "node scripts/build-impact-summary.mjs",
    "validation:impact:summary:check": "node scripts/build-impact-summary.mjs --check",
    "package:source": "bash scripts/package.sh --source-only",
    "test:release:execute": "npm run typecheck && npm run lint:no-ignored-src && npm run lint:no-tracked-ignored && npm run lint:no-host-paths && npm run lint:release-sync && npm run lint:main-deferral && npm run lint:inline-imports && npm run lint:unsafe-html && npm run lint:csp-html && npm run lint:html-assets && npm run lint:python-version && npm run lint:layer-boundaries && npm run lint:mono-usage && npm run lint:editorial-language && npm run lint:position-access && npm run lint:int-truncation && npm run lint:spatial-context && npm run lint:upload-queue-seam && npm run lint:monolith-size && npm run lint:architecture-truth && npm run lint:module-graph && npm run lint:unreachable-modules && npm run lint:worker-registry && npm run lint:claim-register && npm run lint:dataset-citations && npm run lint:terrain-field-ids && npm run lint:digest-manifests && npm run lint:oracle-registry && npm run validation:datasets:verify && npm run validation:field:verify && npm run validation:reproduction:verify && npm run validation:generalization:verify && npm run validation:impact:verify && npm run validation:impact:summary:check && npm run validation:freeze:verify && npm run validation:snapshot:verify && npm run lint:release-truth && npm run lint:license && npm run lint:claim-prose-sync && npm run lint:doc-links && npm run lint:claims-language && npm run lint:archive-vocab && npm run lint:sbom && npm run check:deps && npm run test:build && npm run build:live && npm run check:bundle && npm run test:buckets:verify && npm run benchmark:archive-portability && npm run test:unit && npm run test:export && npm run test:terrain && npm run validation:study:verify && npm run validation:ground-metrics:verify && npm run validation:classifier-corpus:verify && npm run test:ui && npm run test:slow && npm run test:smoke && npm run test:smoke:live && npm run test:smoke:mobile && npm run verify:reachability",
    "test:release:tag": "npm run test:release && npm run test:e2e",
    "gate": "bash scripts/gate.sh",
    "lint:position-access": "node scripts/lint-position-access.mjs",
    "lint:int-truncation": "node scripts/lint-int-truncation.mjs",
    "lint:spatial-context": "node scripts/lint-spatial-context.mjs",
    "lint:positions-reads": "node scripts/lint-positions-reads.mjs",
    "lint:monolith-size": "node scripts/lint-monolith-size.mjs",
    "lint:module-graph": "node scripts/lint-module-graph.mjs",
    "lint:unreachable-modules": "node scripts/lint-unreachable-modules.mjs",
    "lint:architecture-truth": "node scripts/lint-architecture-truth.mjs",
    "verify:archive-gate": "node scripts/verify-archive-gate.mjs",
    "lint:claims-language": "node scripts/lint-claims-language.mjs",
    "lint:archive-vocab": "node scripts/lint-archive-vocab.mjs",
    "lint:csp-html": "node scripts/lint-csp-html.mjs",
    "lint:html-assets": "node scripts/lint-html-assets.mjs",
    "lint:python-version": "node scripts/lint-python-version.mjs",
    "lint:no-host-paths": "node scripts/lint-no-host-paths.mjs",
    "validation:freeze:verify": "node scripts/verify-freeze-claims.mjs",
    "verify:scientific-records": "node scripts/verify-scientific-records.mjs",
    "validate:scientific": "npm run test:terrain && npm run verify:scientific-records",
    "validate:terrain": "node scripts/validate-terrain.mjs",
    "validation:datasets:verify": "node scripts/verify-dataset-register.mjs",
    "validation:datasets:acquire": "node scripts/acquire-dataset.mjs",
    "validation:study:verify": "node scripts/verify-cross-implementation-study.mjs",
    "validation:ground-metrics:verify": "node scripts/verify-ground-filter-metrics.mjs",
    "validation:classifier-corpus:verify": "node scripts/verify-classifier-corpus.mjs",
    "validation:matrix:update": "MATRIX_WRITE=1 vitest run tests/rasterAgreementMatrix.test.ts",
    "lint:doc-links": "node scripts/lint-doc-links.mjs",
    "lint:worker-registry": "node scripts/lint-worker-registry.mjs",
    "lint:claim-prose-sync": "node scripts/lint-claim-prose-sync.mjs",
    "lint:dataset-citations": "node scripts/lint-dataset-citations.mjs",
    "lint:terrain-field-ids": "node scripts/lint-terrain-field-ids.mjs",
    "lint:digest-manifests": "node scripts/lint-digest-manifests.mjs",
    "lint:oracle-registry": "node scripts/lint-oracle-registry.mjs",
    "verify:reference-reproducibility": "node scripts/verify-reference-reproducibility.mjs",
    "lint:pr-hygiene": "node scripts/pr-hygiene.mjs",
    "lint:license": "node scripts/lint-license.mjs",
    "bench:ooc-reopen": "OOC_REOPEN_BENCH=1 playwright test --config playwright.oocReopen.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@loaders.gl/core": "^4.4.4",
    "@loaders.gl/gltf": "^4.4.2",
    "@loaders.gl/obj": "^4.4.2",
    "@loaders.gl/ply": "^4.4.4",
    "laz-perf": "^0.0.7",
    "pdf-lib": "^1.17.1",
    "proj4": "^2.21.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@loaders.gl/las": "^4.4.4",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/proj4": "^2.19.0",
    "@types/three": "^0.184.1",
    "@vitest/coverage-v8": "^4.1.10",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vitepress": "1.6.4",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "minimatch@3": {
      "brace-expansion": "^1.1.16"
    },
    "qs": "^6.15.2",
    "vitepress": {
      "vite": "^6.4.3"
    },
    "texture-compressor": "file:vendor-stubs/texture-compressor",
    "@loaders.gl/las": {
      "laz-perf": "0.0.7"
    }
  }
}
