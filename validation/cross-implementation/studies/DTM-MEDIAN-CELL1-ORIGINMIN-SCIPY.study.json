  "parameterSets": [
    {
      "id": "PS-DTM-MEDIAN-CELL1-ORIGINMIN",
      "description": "Per-cell median, 1 m cells, grid origin at the minimum x and y of the input and extent from the rasterizeDtm rule (cols = floor((max - min) / s) + 1). Even counts take the mean of the two middle values. Empty cells are NoData.",
      "candidateParameters": {
        "function": "rasterizeDtm",
        "aggregation": "median",
        "cellSizeM": 1,
        "grid": "derived by rasterizeDtm from the data minimum",
        "inputShiftM": [
          0.37,
          0.61
        ],
        "verticalAxis": "z"
      },
      "referenceParameters": {
        "function": "scipy.stats.binned_statistic_2d",
        "statistic": "median",
        "bins": "[ox + 1 * arange(cols + 1), oy + 1 * arange(rows + 1)]"
      }
    }
  ],
